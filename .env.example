# Only used by the optional generation script (npm run generate).
# These are NEVER bundled into the website.
#
# Pick one provider:
#   AI_PROVIDER=manual        -> prints a prompt you paste into any (free) chatbot
#   AI_PROVIDER=openai        -> any OpenAI-compatible endpoint (Gemini free tier, Groq,
#                                OpenRouter, a local Ollama server, OpenAI)
#   AI_PROVIDER=anthropic     -> Claude API (paid, per use)
AI_PROVIDER=manual

# Gemini (free tier; key from https://aistudio.google.com/apikey)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# Reasoning models (e.g. Gemini 3) think at full depth by default, which can take minutes.
# low is plenty for summarising given sources. Leave empty for servers that don't support it.
OPENAI_REASONING_EFFORT=low
# auto: when the model is overloaded (503/429/timeout), try other 'flash' models the key can use.
# OPENAI_MODEL also accepts a comma-separated list.
OPENAI_FALLBACK=auto

# Local Ollama instead (free, offline):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: identifies the research script to Wikipedia (their API etiquette), e.g. your repo URL
RESEARCH_CONTACT=
